{
  "name": "devx-icons-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite playground --port 3100 --strictPort",
    "generate": "tsx scripts/generate.ts",
    "build:font": "tsx scripts/build-font.ts",
    "build:packages": "tsx scripts/build-packages.ts",
    "build:raster": "tsx scripts/build-raster.ts",
    "build": "pnpm generate && pnpm build:font && pnpm build:packages",
    "build:all": "pnpm build && pnpm build:raster && pnpm release",
    "sheets": "tsx scripts/contact-sheet.ts",
    "release": "tsx scripts/release.ts",
    "test": "vitest run",
    "typecheck": "tsc -p .",
    "check": "pnpm typecheck && pnpm test",
    "showcase": "tsx scripts/showcase.ts",
    "check-names": "tsx scripts/check-names.ts"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.20.5",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vue/server-renderer": "3.5.13",
    "pathkit-wasm": "^1.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "svg2ttf": "^6.1.0",
    "svgicons2svgfont": "^16.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8",
    "vue": "3.5.13",
    "wawoff2": "^2.0.1"
  },
  "packageManager": "pnpm@10.32.1"
}

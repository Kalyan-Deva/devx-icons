{
  "name": "@kalyan-dev/devx-icons-svelte",
  "version": "1.2.0",
  "description": "DevX Icons for Svelte: 7,000+ icons in line, solid, duotone and bulk, four weights, built-in animation.",
  "license": "MIT",
  "author": "Kalyan Gopalam",
  "homepage": "https://github.com/Kalyan-Deva/devx-icons#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kalyan-Deva/devx-icons.git",
    "directory": "packages/svelte"
  },
  "bugs": {
    "url": "https://github.com/Kalyan-Deva/devx-icons/issues"
  },
  "sideEffects": false,
  "type": "module",
  "svelte": "./dist/index.js",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./icons/*": {
      "types": "./dist/icons/*.d.ts",
      "import": "./dist/icons/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "svelte": ">=4"
  },
  "keywords": [
    "icons",
    "svelte",
    "svg",
    "devx"
  ],
  "publishConfig": {
    "access": "public"
  }
}
